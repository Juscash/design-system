# Variáveis de ambiente do @juscash/design-system
#
# Este pacote é uma biblioteca publicada no GitHub Packages. Não há runtime
# server-side neste repositório. As variáveis abaixo são consumidas em
# fluxos de CI/CD e na instalação por consumidores externos.

# Token usado pelo workflow de publicação (.github/workflows/publish.yml).
# Em CI o GitHub Actions injeta automaticamente via ${{ secrets.GITHUB_TOKEN }}.
# Use um Personal Access Token com escopo `write:packages` para publicar
# manualmente, e `read:packages` para instalar em outro projeto.
NODE_AUTH_TOKEN=

# Token usado pelo agente de revisão automática
# (.github/workflows/code-review-agent.yml). Injetado automaticamente pelo
# GitHub Actions.
GITHUB_TOKEN=

# Chave da API Anthropic, consumida pelo agente de revisão em
# .github/scripts/code-review-agent.js. Definida como secret no GitHub.
ANTHROPIC_API_KEY=

# Flag opcional usada exclusivamente pelo build do Storybook em
# .github/workflows/deploy-docs.yml para gerar paths corretos no GitHub
# Pages. Defina como "true" apenas em ambientes que publicam o Storybook
# estatico em https://<owner>.github.io/<repo>/.
GITHUB_PAGES=
