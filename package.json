{
  "name": "design_juscash",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "npm run build -w @juscash/design-system && npm run build-storybook -w @juscash/storybook",
    "build:design-system": "npm run build -w @juscash/design-system",
    "build:docs": "npm run build-storybook -w @juscash/storybook",
    "dev": " node scripts/kill-port-6006.js && npm run storybook -w @juscash/storybook",
    "lint": "echo \"no lint configured\"",
    "test": "echo \"no tests configured\"",
    "test:docs": "npm run test-storybook -w @juscash/storybook",
    "start": "npm run start -w @juscash/storybook",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "version:publish": "node scripts/version-publish.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "fdir": "^6.5.0",
    "is-core-module": "^2.16.1",
    "tinyglobby": "^0.2.15",
    "typescript": "^5.6.3"
  }
}
